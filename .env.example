APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_16_digit_gmail_app_password
MAIL_FROM_ADDRESS="your_gmail@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Token bí mật cho kiosk chấm công khuôn mặt (phải trùng face-service/.env)
FACE_KIOSK_TOKEN=
FACE_MODEL_NAME=buffalo_l
# URL API Python xác thực khuôn mặt (chạy: python face-service/api_server.py)
FACE_API_URL=http://127.0.0.1:5555

# Phép năm: pro-rata và quy ước tháng vào làm
# LEAVE_ANNUAL_DAYS=12
# LEAVE_MONTHLY_PAID_DAYS=1
# LEAVE_MID_MONTH_CUTOFF_DAY=15
# LEAVE_MID_MONTH_AFTER_CUTOFF=next_month
# LEAVE_MID_MONTH_AFTER_CUTOFF=current_month
# LEAVE_ACCRUAL_DAYS_PER_MONTH=1
# LEAVE_ACCRUAL_SCHEDULE_TIME=23:30
# LEAVE_UNPAID_ACCRUAL_BLOCK_DAYS=12
# LEAVE_SICK_ACCRUAL_ALLOWED_MONTHS=2
# LEAVE_CARRY_OVER_ENABLED=true
# LEAVE_CARRY_OVER_EXPIRY_MONTH=4
# LEAVE_CARRY_OVER_MAX_DAYS=
# LEAVE_DEPARTMENT_CAPACITY_ENFORCEMENT=override

# Tăng ca — giới hạn theo Luật Lao động
# OVERTIME_DEFAULT_NORMAL_HOURS=8
# OVERTIME_DAILY_RATIO=0.5
# OVERTIME_MAX_TOTAL_HOURS_PER_DAY=12
# OVERTIME_MAX_HOURS_PER_MONTH=40
# OVERTIME_MAX_HOURS_PER_YEAR=200
# OVERTIME_EXTENDED_ANNUAL_LIMIT=false
# OVERTIME_MAX_HOURS_PER_YEAR_EXTENDED=300
# OVERTIME_WARNING_RATIO=0.8
# OVERTIME_LABOR_DEPT_NOTIFICATION_HOURS=200
# OVERTIME_MIN_REASON_LENGTH=10

VITE_APP_NAME="${APP_NAME}"
